{
  "name": "family-app",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:api": "tsx watch services/api/src/index.ts",
    "build": "pnpm typecheck && vite build --config apps/web/vite.config.ts && tsc -p services/api/tsconfig.json",
    "typecheck": "vue-tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p services/api/tsconfig.json",
    "db:generate": "prisma generate --schema database/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema database/schema.prisma",
    "test": "tsx --test tests/*.test.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "start": "node dist/api/index.js",
    "test:db:up": "docker compose -f compose.test.yaml up -d --wait",
    "test:db:stop": "docker compose -f compose.test.yaml stop",
    "seed:initial": "tsx scripts/seed-initial.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.3.0",
    "@prisma/client": "6.19.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.1",
    "google-auth-library": "^10.3.0",
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "prisma": "6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vue-tsc": "^3.1.0"
  }
}
