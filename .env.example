# Copy to .env. Never commit actual credentials.
DATABASE_URL="mysql://family_app:CHANGE_ME@127.0.0.1:3306/family_app"
APP_ORIGIN="http://localhost:5173"
PORT=3001
# Public Google OAuth Web client ID; client secret is not required for GIS ID-token sign-in.
GOOGLE_CLIENT_ID=""
# Explicitly allow only your own Google account to create the first family.
BOOTSTRAP_PARENT_EMAIL=""
NODE_ENV="development"
# Do not enable on a shared/public server. Demo routes bind to loopback and require a demo_ DB.
DEMO_MODE="false"

# Calendar read-only authorization (separate from sign-in)
GOOGLE_CLIENT_SECRET=""
# 32-byte random key as 64 hex characters; keep stable to decrypt saved refresh tokens.
CALENDAR_TOKEN_KEY=""

# Written by seed:initial; attaches the first verified parent to the prepared family.
INITIAL_FAMILY_ID=""
